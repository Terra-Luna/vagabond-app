    "@tailwindcss/vite": "4.3.0",
    "lexical": "0.45.0",
    "lint": "1.2.2",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-draggable": "4.5.0",
    "react-html-parser": "2.0.2",
    "react-resizable": "^4.0.2",
    "react-select": "^5.10.2",
