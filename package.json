{
  "name": "vagabond-lite",
  "description": "",
  "scripts": {
    "build": "pnpm vite build",
    "foundry": "node \"C:/Program Files/FoundryVTT-Node/main.js\" --dataPath=%userprofile%/AppData/Local/FoundryVTT",
    "foundry-linux": "node ~/Apps/FoundryVTT-Node/main.js",
    "vite-no": "pnpm vite --open 0",
    "circ-deps": "pnpm dlx madge --circular --extensions ts,tsx,js,jsx ./src",
    "test": "pnpm build && node --trace-warnings node_modules/jest/bin/jest.js",
    "clean-": "echo Y | rmdir /s dist && pnpm clean",
    "lint": "eslint src && pnpm circ-deps",
    "lint:fix": "eslint --fix src"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.0.9",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
