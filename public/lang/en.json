    "StatusConditions": {
      "berserk": {
        "name": "Berserk",
        "description": "Can't take the Cast Action or Focus, it can't be Frightened, and it doesn't make Morale Checks."
      },
      "blinded": {
        "name": "Blinded",
        "description": "Can't see and is Vulnerable."
      },
      "burning": {
        "name": "Burning",
        "description": "A die roll indicates damage it takes at the start of its turns, unless an appropriate action is taken to end it (such as dousing fire)."
      },
      "charmed": {
        "name": "Charmed",
        "description": "It can't willingly attack the charmer."
      },
      "confused": {
        "name": "Confused",
        "description": "Its Checks and Saves have Hinder, and Saves against its Actions have Favor."
      },
      "dazed": {
        "name": "Dazed",
        "description": "It can't Focus or Move unless it uses an Action to do so."
      },
      "fatigued": {
        "name": "Fatigued",
        "description": "Fatigue is measured from 0 to 5 with the following rules: - Each Fatigue occupies an Item Slot. - At 3 or ore Fatigue, it can't Rush. - At 5 Fatigue, it dies."
      },
      "frightened": {
        "name": "Frightened",
        "description": "It has a -2 penalty to damage it deals."
      },
      "grappling": {
        "name": "Grappling",
        "description": "Physically causing a Target to be Restrained by using your body is Grappling. A Being that is physically restraining a Target has its Speed halved, unless the Target is smaller."
      },
      "incapacitated": {
        "name": "Incapacitated",
        "description": "It can't Focus or use its Actions or Move, fails all Might and Dexterity Checks, and is Vulnerable."
      },
      "invisible": {
        "name": "Invisible",
        "description": "It can't be seen by normal senses, and thos that can't see it act as Blinded for Checks and Saves involving it."
      },
      "paralyzed": {
        "name": "Paralyzed",
        "description": "It is Incapacitated and its Speed is 0."
      },
      "prone": {
        "name": "Prone",
        "description": "You can either drop or stand from Prone by using 10' of Speed. While Prone: Speed cost is halved, it cannot Rush, and is Vulnerable for the purposes of Melee Attacks and Dodge Checks."
      },
      "restrained": {
        "name": "Restrained",
        "description": "It is Vulnerable and its Speed is 0."
      },
      "sickened": {
        "name": "Sickened",
        "description": "It has a -2 penalty to any healing it receives. Additional effects may be indicated by the cause of the Sickness."
      },
      "suffocating": {
        "name": "Suffocating",
        "description": "Beings begin Suffocating after not breathing for 1 Minute. Heroes: Each Round, while Suffocating, roll a d8. If the result is equal to or greater than your Might, gain 1 Fatigue. Enemies: Each Round, while Suffocating, gain 1 Fatigue."
      },
      "unconscious": {
        "name": "Unconscious",
        "description": "It is Blinded, Incapacitated, and Prone. Close Attacks Targeting it always Crit."
      },
      "vulnerable": {
        "name": "Vulnerable",
        "description": "Its attacks and Saves against attacks have Hinder. Attacks targeting it and Saves against its attacks have Favor."
      }
    },
