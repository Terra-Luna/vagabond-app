{
  "id": "vagabond-lite",
  "title": "Vagabond Lite",
  "description": "A lightweight system for the Vagabond TTRPG.",
  "version": "0.0.0",
  "url": "https://github.com/Terra-Luna/vagabond-lite",
  "manifest": "https://github.com/Terra-Luna/vagabond-lite/system.json",
  "download": "https://github.com/Terra-Luna/vagabond-lite/archive/vagabond-lite.zip",
  "license": "LICENSE",
  "compatibility": {
    "minimum": "14",
    "verified": "14.361"
  },
  "authors": [
    {
      "name": "Terra",
      "url": "https://github.com/Terra-Luna",
      "discord": "@dreampop_luna"
    },
    {
      "name": "Ada",
      "url": "https://github.com/AdaData"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "html",
        "hbs",
        "json"
      ],
      "paths": [
        "css",
        "lang",
        "templates"
      ]
    }
  },
  "documentTypes": {
    "Actor": {
      "hero": {},
      "adversary": {},
      "npc": {}
    },
    "Item": {
      "ancestry": {
        "htmlFields": [
          "description"
        ]
      },
      "class": {
        "htmlFields": [
          "description"
        ]
      },
      "equipment": {
        "htmlFields": [
          "description"
        ]
      },
      "perk": {
        "htmlFields": [
          "description"
        ]
      },
      "spell": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "packs": [
    {
      "name": "adversaries",
      "label": "Adversaries",
      "type": "Actor",
      "system": "vagabond-lite",
      "path": "packs/adversaries.db",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "weapons",
      "label": "Weapons",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/weapons.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "armor",
      "label": "Armor",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/armor.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "sundries",
      "label": "Sundries",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/sundries.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "spells",
      "label": "Spells",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/spells.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "ancestries",
      "label": "Ancestries",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/ancestries.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "classes",
      "label": "Classes",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/classes.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "esmodules": [
    "vagabond-lite.js"
  ],
  "styles": [
    "vagabond-lite.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": false,
  "grid": {
    "type": 1,
    "distance": 5,
    "units": "ft",
    "diagonals": 0
