    "actions": [
      {
        "name": "Spawn",
        "effect": "<p><span style=\"white-space: pre-wrap;\">At the start of its Turn, roll d4. On a roll of 2 to 4, this Being spawns an Ally Being (d6, roll two and take the highest if this Being is at half HP or lower), which appears in the nearest open space:</span></p><p><br></p><p><span style=\"white-space: pre-wrap;\">1 Giant Spider (p. 132) </span></p><p><span style=\"white-space: pre-wrap;\">2 Basilisk (p. 135) </span></p><p><span style=\"white-space: pre-wrap;\">3 Owl Bear (p. 145) </span></p><p><span style=\"white-space: pre-wrap;\">4 Rust Monster (p. 147) </span></p><p><span style=\"white-space: pre-wrap;\">5 Warp Beast (p. 151) </span></p><p><span style=\"white-space: pre-wrap;\">6 Gelatinous Cube (p. 172)</span></p>",
