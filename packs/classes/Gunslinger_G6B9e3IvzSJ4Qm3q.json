    "features": [
      {
        "level": 1,
        "name": "Deadeye",
        "description": "<p><span style=\"white-space: pre-wrap;\">After you make a Ranged attack, you Crit on subsequent Ranged attacks on a d20 roll 1 lower, but no lower than 17. This resets to 0 at the end of your Turn if you didn’t hit a Ranged attack since the start of your last Turn.</span></p>"
      },
      {
        "level": 1,
        "name": "Quickdraw",
        "description": "<p><span style=\"white-space: pre-wrap;\">You gain the Marksmanship Perk (p. 69) and, when Combat occurs, you can make one Ranged attack before the first Turn, which is Hindered if it is made with a 2H Weapon.</span></p>"
      },
      {
        "level": 2,
        "name": "Skeet Shooter",
        "description": "<p><span style=\"white-space: pre-wrap;\">Once per Round, you can make a Ranged attack against an attack that would hit. If you pass, reduce the damage dealt by the Target’s attack by your attack’s damage.</span></p>"
      },
      {
        "level": 4,
        "name": "Grit",
        "description": "<p><span style=\"white-space: pre-wrap;\">When you Crit on a Ranged attack, the damage dice can Explode.</span></p>"
      },
      {
        "level": 6,
        "name": "Devastator",
        "description": "<p><span style=\"white-space: pre-wrap;\">When you kill an Enemy, your Deadeye Feature is immediately set to 17.</span></p>"
      },
      {
        "level": 8,
        "name": "Bad Medicine",
        "description": "<p><span style=\"white-space: pre-wrap;\">You deal an extra die of damage when you Crit with a Ranged Check.</span></p>"
      },
      {
        "level": 10,
        "name": "High Noon",
        "description": "<p><span style=\"white-space: pre-wrap;\">Once per Turn, if you Crit on a Ranged Check, you can make one additional attack.</span></p>"
      }
    ]
  },
