    "features": [
      {
        "name": "Hunter's Mark",
        "level": 1,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">You can choose a Target when you attack it or by skipping your Move, declaring it is your Mark until you declare a new Mark. The following rules apply while you have a Mark:</span></p><p><br></p><p><span style=\"white-space: pre-wrap;\">• Your attacks against it have the Keen and Vicious properties.</span></p><p><span style=\"white-space: pre-wrap;\">• When you attack or track the Mark, roll two d20s and use the highest for the Check.</span></p>"
      },
      {
        "name": "Survivalist",
        "level": 1,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">You gain a Perk with Survival Training as a Prerequisite, ignoring other prerequisites for it. Further, you have Favor on Checks to track, navigate, and against extreme temperatures, and you can Forage at a Normal Travel Pace.</span></p>"
      },
      {
        "name": "Rover",
        "level": 2,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">Difficult Terrain doesn’t impede your walking Speed, and you have Climb and Swim.</span></p>"
      },
      {
        "name": "Overwatch",
        "level": 4,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">Your additional d20 of Hunter’s Mark also applies to your Saves provoked by the Mark.</span></p>"
      },
      {
        "name": "Lethal Precision",
        "level": 6,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">You ignore Hinder caused by your Mark.</span></p>"
      },
      {
        "name": "Quarry",
        "level": 8,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">You can sense Beings within Far as if by Blindsight if they are missing any HP or are your Mark.</span></p>"
      },
      {
        "name": "Apex Predator",
        "level": 10,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">Your Mark is Weak to your attacks.</span></p>"
      }
    ]
  },
