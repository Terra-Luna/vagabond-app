    "features": [
      {
        "name": "Occultist",
        "level": 1,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">You gain a Perk with the Trained: Mysticism Prerequisite, and you can Cast Spells using Mysticism.</span></p><p><br></p><p><b><strong style=\"white-space: pre-wrap;\">Spells:</strong></b><span style=\"white-space: pre-wrap;\"> You learn 4 Spells. You learn 1 other Spell every 2 Levels hereafter.</span></p><p><br></p><p><b><strong style=\"white-space: pre-wrap;\">Mana:</strong></b><span style=\"white-space: pre-wrap;\"> Your Max Mana is equal to (4 × your Level), and the highest amount of Mana you can spend to Cast a Spell is equal to (2 + your Level).</span></p>"
      },
      {
        "name": "Hex",
        "level": 1,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">When you affect Enemies with the effect of a Spell, you can hex one of the Targeted Enemies. Doing so causes the effect to be continual until you hex a new Target.</span></p>"
      },
      {
        "name": "Widdershins",
        "level": 2,
        "scale": 4,
        "description": "<p><span style=\"white-space: pre-wrap;\">Your damage from Spell effects and your effective Level for the purpose of Spell effects are both increased by 1 against your hexed Target, and increased 1 more every 4 Levels hereafter.</span></p>"
      },
      {
        "name": "Grudge Bearer",
        "level": 4,
        "scale": 4,
        "description": "<p><span style=\"white-space: pre-wrap;\">The number of Spells you can cause to be continual on the Target with your Hex Feature increases by 1 now and every 4 Levels hereafter.</span></p><p><br></p><p><span style=\"white-space: pre-wrap;\">Further, if you hex a new Target while you have an Enemy hexed, the new Target is affected by the previous Spells.</span></p>"
      }
    ]
