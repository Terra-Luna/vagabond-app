    "features": [
      {
        "name": "Spellcaster",
        "level": 1,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">You can Cast Spells using Arcana.</span></p><p><br></p><p><b><strong style=\"white-space: pre-wrap;\">Spells: </strong></b><span style=\"white-space: pre-wrap;\">You learn 4 Spells. You learn 1 other Spell every 2 Wizard Levels hereafter.</span></p><p><br></p><p><b><strong style=\"white-space: pre-wrap;\">Mana: </strong></b><span style=\"white-space: pre-wrap;\">Your Max Mana is equal to (4 × your Level), and the highest amount of Mana you can spend to Cast a Spell is equal to (2 + your Level).</span></p>"
      },
      {
        "name": "Page Master",
        "level": 1,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">You gain the Bookworm Perk (p. 64).</span></p><p><br></p><p><span style=\"white-space: pre-wrap;\">Further, you can spend your Studied dice and add them to the damage or healing roll of a Spell you Cast.</span></p>"
      },
      {
        "name": "Sculpt Spell",
        "level": 2,
        "scale": 4,
        "description": "<p><span style=\"white-space: pre-wrap;\">You pay 1 less Mana for Delivery upcasting. This discount is increased by 1 every 4 Levels hereafter.</span></p>"
      },
      {
        "name": "Manifold Mind",
        "level": 4,
        "scale": 4,
        "description": "<p><span style=\"white-space: pre-wrap;\">The number of Spells you can Focus on at the same time increases by 1 now and every 4 Levels hereafter.</span></p>"
      },
      {
        "name": "Extracurricular",
        "level": 6,
        "scale": 0,
        "description": "<p><span style=\"white-space: pre-wrap;\">You can spend a Studied die to learn a Spell for the Shift.</span></p>"
