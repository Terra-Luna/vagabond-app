{
  "id": "vagabond-lite",
  "title": "Vagabond Lite",
  "description": "A lightweight system for the Vagabond TTRPG.",
  "version": "0.0.0",
  "url": "https://github.com/Terra-Luna/vagabond-lite",
  "manifest": "https://github.com/Terra-Luna/vagabond-lite/system.json",
  "download": "https://github.com/Terra-Luna/vagabond-lite/archive/vagabond-lite.zip",
  "license": "LICENSE",
  "compatibility": {
    "minimum": "14",
    "verified": "14.361"
  },
  "authors": [
    {
      "name": "Terra",
      "url": "https://github.com/Terra-Luna",
      "discord": "@dreampop_luna"
    },
    {
      "name": "Ada",
      "url": "https://github.com/AdaData"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "html",
        "hbs",
        "json"
      ],
      "paths": [
        "css",
        "lang",
        "templates"
      ]
    }
  },
  "documentTypes": {
    "Actor": {
      "hero": {},
      "adversary": {}
    }
  },
  "packs": [
    {
      "name": "adversaries",
      "label": "Adversaries",
      "type": "Actor",
      "system": "vagabond-lite",
      "path": "packs/adversaries.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "items",
      "label": "Items",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/items.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "weapons",
      "label": "Weapons",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/weapons.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "armor",
      "label": "Armor",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/armor.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "relics",
      "label": "Relics",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/relics.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "spells",
      "label": "Spells",
      "type": "Item",
      "system": "vagabond-lite",
      "path": "packs/spells.db",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "esmodules": [
    "build/vagabond-lite.mjs"
  ],
  "styles": [
    "styles/system-styles.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": false,
  "grid": {
    "type": 2,
    "distance": 5,
    "units": "ft",
    "diagonals": 0
  },
  "primaryTokenAttribute": "resources.health",
  "media": [
    {
      "type": "setup",
      "url": "systems/vagabond-lite/assets/splash.png",
      "thumbnail": "systems/vagabond-lite/assets/splash.png"
    }
  ],
  "background": "systems/vagabond-lite/assets/splash.png"
}